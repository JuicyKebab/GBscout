# Publieke site-URL (voor canonical, sitemap, JSON-LD). Zet dit op het echte domein.
NEXT_PUBLIC_SITE_URL=https://gbscout.com

# Wie verantwoordelijk is voor de site. Verschijnt op /privacy en /methodology. Vul dit in vóór
# livegang en vóór je een affiliate-programma aanvraagt (netwerken vragen om een contactadres
# en privacybeleid). Zonder waarde laat /privacy de sectie "Who is responsible" weg.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=

# Affiliate-links per provider. Zonder waarde linkt de site naar de gewone provider-URL
# (zonder rel="sponsored"). Placeholders: {subid} = paginanaam voor attributie,
# {url} = URL-encoded diepe link naar het plan of de landpagina.
# Voorbeeld Travelpayouts: https://tp.media/r?marker=XXXX&trs=XXXX&p=XXXX&u={url}&sub_id={subid}
AFF_AIRALO=
AFF_YESIM=
AFF_UBIGI=
AFF_JETPAC=
AFF_SAILY=
AFF_HOLAFLY=
AFF_NOMAD=
