# Security headers voor alle routes (Cloudflare Worker static assets, net als _redirects).
# De site is een statische Next-export zonder server, user-input, DB of auth; dit is
# defense-in-depth. CSP: alles van 'self'; 'unsafe-inline' is nodig omdat een statische
# Next-export inline bootstrap-scripts/styles zonder nonce uitstuurt. Externe provider-URL's
# zijn <a href>-navigaties (niet door CSP beperkt). Voeg je later analytics toe, pas dan
# script-src/connect-src aan.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
